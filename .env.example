# GREEN-API: Базовый URL сервиса (по умолчанию https://api.green-api.com или адрес вашего регионального кластера)
NEXT_PUBLIC_GREEN_API_URL=https://api.green-api.com

# GREEN-API: Учетные данные инстанса по умолчанию (необязательно, для автозаполнения в форме входа)
NEXT_PUBLIC_DEFAULT_ID_INSTANCE=
NEXT_PUBLIC_DEFAULT_API_TOKEN_INSTANCE=

# GREEN-API HTTP API: Настройки получения сообщений
# Таймаут ожидания уведомления в секундах (5-60 сек)
NEXT_PUBLIC_RECEIVE_TIMEOUT_SECONDS=5
# Интервал между циклами опроса очереди в миллисекундах
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=2000
